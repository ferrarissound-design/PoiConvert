<Window x:Class="PoiConvert.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PoiConvert.ViewModels"
        Title="PoiConvert - 動画・音声 爆速コンバーター"
        Width="1040" Height="820" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI" FontSize="13"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- ツールバー -->
      <RowDefinition Height="*" MinHeight="160" />  <!-- キュー -->
      <RowDefinition Height="Auto" />  <!-- モード -->
      <RowDefinition Height="Auto" />  <!-- 出力・設定 -->
      <RowDefinition Height="Auto" />  <!-- 実行 -->
      <RowDefinition Height="150" />  <!-- ログ -->
    </Grid.RowDefinitions>

    <!-- ツールバー -->
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button Content="＋ ファイルを追加" Command="{Binding AddFilesCommand}" />
        <Button Content="選択を削除" Click="RemoveSelected_Click" IsEnabled="{Binding IsIdle}" />
        <Button Content="全クリア" Command="{Binding ClearAllCommand}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="#C62828" FontWeight="Bold" Text="⚠ FFmpeg が見つかりません（下の「設定」から指定）"
                 Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVis}}" />
    </DockPanel>

    <!-- キュー -->
    <Grid Grid.Row="1">
      <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Items}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                RowHeight="26" KeyDown="QueueGrid_KeyDown" Background="White">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding Message}" />
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="*" />
          <DataGridTextColumn Header="長さ" Binding="{Binding DurationText}" Width="70" />
          <DataGridTextColumn Header="解像度" Binding="{Binding ResolutionText}" Width="95" />
          <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="80" />
          <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="80">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ItemStatus.Done}">
                    <Setter Property="Foreground" Value="#2E7D32" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ItemStatus.Failed}">
                    <Setter Property="Foreground" Value="#C62828" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ItemStatus.ProbeFailed}">
                    <Setter Property="Foreground" Value="#C62828" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ItemStatus.Running}">
                    <Setter Property="Foreground" Value="#1565C0" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="進捗" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                  <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="ここに動画・音声ファイル（またはフォルダ）をドラッグ＆ドロップ"
                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#999"
                 IsHitTestVisible="False"
                 Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}" />
    </Grid>

    <!-- モード -->
    <TabControl Grid.Row="2" Margin="0,10,0,0" SelectedIndex="{Binding SelectedModeIndex}"
                IsEnabled="{Binding IsIdle}" MinHeight="120">
      <!-- 順番は ConversionMode と同じにすること -->
      <TabItem Header="🎵 音声抽出">
        <StackPanel Margin="10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Label}" Text="出力形式" />
            <ComboBox ItemsSource="{Binding AudioFormatChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding AudioFormat}" MinWidth="220" />
            <TextBlock Style="{StaticResource Label}" Text="ビットレート" />
            <ComboBox ItemsSource="{Binding AudioBitrateChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding AudioBitrate}" IsEnabled="{Binding IsAudioBitrateEnabled}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}"
                     Text="「元のまま」は音質が劣化せず一瞬で終わります。拡張子は元の音声形式に合わせて自動で決まります（例：AAC → .m4a）。WAV・元のままではビットレート指定は使いません。" />
        </StackPanel>
      </TabItem>

      <TabItem Header="📦 軽量化">
        <StackPanel Margin="10">
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="画質で指定" GroupName="CompressMode" IsChecked="{Binding UseQualityPreset}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding QualityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Quality}" IsEnabled="{Binding UseQualityPreset}" MinWidth="160" />
            <RadioButton Content="目標サイズで指定" GroupName="CompressMode" IsChecked="{Binding UseTargetSize}" VerticalAlignment="Center" Margin="12,0,8,0" />
            <TextBox Text="{Binding TargetSizeText, UpdateSourceTrigger=PropertyChanged}" Width="70" VerticalContentAlignment="Center"
                     IsEnabled="{Binding UseTargetSize}" />
            <TextBlock Style="{StaticResource Label}" Text=" MB（2パス）" Margin="4,0,16,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Label}" Text="解像度" />
            <ComboBox ItemsSource="{Binding ResolutionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Resolution}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                       Text="縦横比はそのまま・縮小のみ（元より大きくはしません）。出力は H.264 + AAC の MP4。" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="🎞 GIF化">
        <StackPanel Margin="10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Label}" Text="開始" />
            <TextBox Text="{Binding GifStartText, UpdateSourceTrigger=PropertyChanged}" Width="70" VerticalContentAlignment="Center" />
            <TextBlock Style="{StaticResource Label}" Text="秒　長さ" Margin="4,0,6,0" />
            <TextBox Text="{Binding GifDurationText, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalContentAlignment="Center" />
            <TextBlock Style="{StaticResource Label}" Text="秒" Margin="4,0,16,0" />
            <TextBlock Style="{StaticResource Label}" Text="FPS" />
            <ComboBox ItemsSource="{Binding GifFpsChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding GifFps}" MinWidth="90" />
            <TextBlock Style="{StaticResource Label}" Text="横幅" />
            <ComboBox ItemsSource="{Binding GifWidthChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding GifWidth}" MinWidth="100" />
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}" Text="開始時間は「12.5」（秒）や「1:23」（分:秒）でも入力できます。色パレットを先に作る2段階方式で高画質に変換します。" />
          <TextBlock Text="{Binding GifWarning}" Foreground="#E65100" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="🔁 形式変換">
        <StackPanel Margin="10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Label}" Text="変換先" />
            <ComboBox ItemsSource="{Binding ContainerChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Container}" />
            <CheckBox Content="できるだけ再エンコードしない（-c copy：一瞬で終わり画質も劣化しない）"
                      IsChecked="{Binding PreferCopy}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}"
                     Text="中身の形式が変換先に入らない場合（例：H.264 → WEBM）は、自動的に再エンコードに切り替えます（ログに表示）。" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- 出力・設定 -->
    <Grid Grid.Row="3" Margin="0,10,0,0" IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <GroupBox Header="出力先" Grid.Column="0">
        <StackPanel Margin="6">
          <RadioButton Content="元ファイルと同じフォルダ" GroupName="Output" IsChecked="{Binding OutputToSourceFolder}" />
          <DockPanel Margin="0,6,0,0">
            <RadioButton Content="指定フォルダ" GroupName="Output" IsChecked="{Binding OutputToCustomFolder}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="参照…" Command="{Binding BrowseOutputFolderCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     IsEnabled="{Binding OutputToCustomFolder}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="同じ名前のファイルがあっても上書きしません（「_1」「_2」…と連番を付けます）。" />
        </StackPanel>
      </GroupBox>
      <GroupBox Header="設定" Grid.Column="2">
        <StackPanel Margin="6">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Label}" Text="同時実行数" />
            <ComboBox ItemsSource="{Binding ConcurrencyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Concurrency}" />
            <TextBlock Style="{StaticResource Label}" Text="エンコード速度" />
            <ComboBox ItemsSource="{Binding X264PresetChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding X264Preset}" MinWidth="170" />
          </StackPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Label}" Text="FFmpeg" />
            <Button DockPanel.Dock="Right" Content="変更…" Command="{Binding ChangeFfmpegCommand}" Margin="6,0,0,0" />
            <TextBlock Text="{Binding FfmpegStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FfmpegStatus}" />
          </DockPanel>
        </StackPanel>
      </GroupBox>
    </Grid>

    <!-- 実行 -->
    <DockPanel Grid.Row="4" Margin="0,12,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="▶ 変換開始" Command="{Binding StartCommand}" FontWeight="Bold" Padding="20,6" Background="#1976D2" Foreground="White" />
        <Button Content="■ キャンセル" Command="{Binding CancelCommand}" Padding="14,6" />
        <Button Content="📂 出力フォルダを開く" Command="{Binding OpenOutputFolderCommand}" Padding="14,6" Margin="0" />
      </StackPanel>
      <Grid Margin="0,0,12,0" VerticalAlignment="Center">
        <ProgressBar Height="24" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" />
        <TextBlock Text="{Binding OverallText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
      </Grid>
    </DockPanel>

    <!-- ログ -->
    <DockPanel Grid.Row="5">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="ログを消去" Command="{Binding ClearLogCommand}" Padding="8,0" MinHeight="22" Margin="0" FontSize="11" />
        <TextBlock Text="ログ（失敗したときは ffmpeg のエラー出力の末尾がここに出ます）" Foreground="#666" VerticalAlignment="Center" />
      </DockPanel>
      <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
               FontFamily="Consolas, BIZ UDGothic, MS Gothic" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" TextChanged="LogBox_TextChanged" />
    </DockPanel>
  </Grid>
</Window>
